{
  "dns": {
    "hosts": {
      "domain:googleapis.cn": "googleapis.com",
      "dns.google": ["8.8.8.8", "8.8.4.4"]
    },
    "servers": [
      "1.1.1.1",
      {
        "address": "223.5.5.5",
        "domains": ["geosite:private", "domain:ir", "geosite:category-ir"],
        "skipFallback": true,
        "tag": "domestic-dns0"
      }
    ],
    "tag": "dns-module"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": true, "userLevel": 8 },
      "sniffing": { "destOverride": ["http", "tls", "fakedns"], "enabled": true, "routeOnly": true },
      "tag": "socks"
    }
  ],
  "log": { "loglevel": "warning" },
  "outbounds": [
    {
      "mux": { "concurrency": -1, "enabled": false },
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [
              { "encryption": "none", "id": "00000000-0000-4000-8000-000000000000", "level": 8 }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "sockopt": { "domainStrategy": "UseIPv4" },
        "tlsSettings": {
          "allowInsecure": false,
          "alpn": ["http/1.1"],
          "fingerprint": "chrome",
          "serverName": "example.com",
          "show": false
        },
        "wsSettings": { "headers": { "Host": "example.com" }, "path": "/assets" }
      },
      "tag": "proxy"
    },
    { "protocol": "freedom", "settings": { "domainStrategy": "UseIPv4" }, "tag": "direct" },
    { "protocol": "blackhole", "settings": { "response": { "type": "http" } }, "tag": "block" }
  ],
  "policy": {
    "levels": { "8": { "connIdle": 300, "downlinkOnly": 4, "handshake": 8, "uplinkOnly": 4 } },
    "system": { "statsOutboundUplink": true, "statsOutboundDownlink": true }
  },
  "remarks": "Sample-443",
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      { "network": "udp", "outboundTag": "block", "port": "443", "type": "field" },
      { "ip": ["geoip:ir"], "outboundTag": "direct", "type": "field" },
      { "inboundTag": ["dns-module"], "outboundTag": "proxy", "type": "field" }
    ]
  },
  "stats": {}
}
